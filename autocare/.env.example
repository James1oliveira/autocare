# Copy this file to .env and fill in the values.

# Shared by auth-service (signs tokens) and api-gateway (checks them).
# Use a long random string, at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional. Without it the assistant runs in offline keyword mode.
OPENAI_API_KEY=

# Password for the local PostgreSQL container
POSTGRES_PASSWORD=autocare
